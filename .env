NODE_ENV=development
REACT_APP_API_URL=http://localhost:5000

# MongoDB Configuration
# Choose ONE of the following:

# 🔴 Option 1: Local MongoDB (Development)
# MONGODB_URI=mongodb://localhost:27017/attendance-system

MONGODB_URI=mongodb+srv://Admin:admin123@cluster0.ztigwfi.mongodb.net/attendance-system?retryWrites=true&w=majority

# 📧 Email Configuration for Attendance Notifications
# Google Gmail Setup:
# 1. Go to myaccount.google.com
# 2. Security → App passwords → Generate password for "Mail" and "Windows Computer"
# 3. Copy the 16-character password here

EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# 📱 SMS Configuration for Attendance Notifications (Twilio)
# Get credentials at: https://www.twilio.com/console
# 1. Sign up for free Twilio account
# 2. Find Account SID and Auth Token in Twilio Console
# 3. Buy a Twilio phone number (for sending SMS)

TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=false



